<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111">

    <!-- TOP EMPTY SPACE -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <!-- Common header -->
    <include
        layout="@layout/common_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"/>

        <TextView
            android:id="@+id/gameTitle"
            android:tag="gameHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mastermind"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share"/>
    </LinearLayout>

    <!-- GAME AREA CENTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!--spinner level-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:orientation="horizontal">

            <!--level text-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="5dp"
                android:text="Level: " />

            <!--level dropdown-->
            <Spinner
                android:id="@+id/spinnerDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!--    switch duplicate colors-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">
            <!--switch text            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="5dp"
                android:text="Duplicate Colors Allowed:" />

            <!--switch button-->
            <Switch
                android:id="@+id/switchDuplicate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp" />

            <!--switch status-->
            <TextView
                android:id="@+id/txtDuplicateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Not Allowed" />
        </LinearLayout>

        <!--attemp and status-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:orientation="horizontal">

            <!--atttemp / max attemps -->
            <TextView
                android:id="@+id/txtAttempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingRight="5dp"
                android:text="Attempts: 12"
                android:textSize="18sp" />

            <!-- score -->
            <TextView
                android:id="@+id/txtScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Score: 0"
                android:textSize="18sp" />
        </LinearLayout>

    <!-- status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"/>

        <!--secret code row-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/secretCodeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

        </LinearLayout>

        <!--    </HorizontalScrollView>-->
        <!-- Guess Row -->
        <LinearLayout
            android:id="@+id/guessRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:orientation="horizontal" />

        <!-- Feedback Pegs -->
        <GridLayout
            android:id="@+id/feedbackGrid"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_gravity="center_horizontal"
            android:columnCount="6"
            android:rowCount="1" />

        <!-- Color Buttons -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <!-- Color Buttons row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/redBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#F44336"
                    android:padding="0dp"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/blueBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2196F3"
                    android:padding="0dp"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/greenBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#4CAF50"
                    android:padding="0dp"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/yellowBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#FFEB3B"
                    android:padding="0dp"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/purpleBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#9C27B0"
                    android:padding="0dp"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/orangeBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#FF9800"
                    android:padding="0dp"
                    android:text="6"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cyanBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#00BCD4"
                    android:padding="0dp"
                    android:text="7"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinkBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#E91E63"
                    android:padding="0dp"
                    android:text="8"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/brownBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#795548"
                    android:padding="0dp"
                    android:text="9"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/grayBtn"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#9E9E9E"
                    android:padding="0dp"
                    android:text="10"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
        <!--button row-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp">

            <!--rules button-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rules" />

            <!--  check button-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CHECK" />

            <!--restart button-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restart" />

        </LinearLayout>

    <!--  history view-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    </LinearLayout>

    <!-- BOTTOM EMPTY SPACE -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="30dp"/>
</LinearLayout>
