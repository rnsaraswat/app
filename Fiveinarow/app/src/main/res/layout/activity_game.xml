<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_neon"
    android:padding="10dp">

    <!-- TOP EMPTY SPACE -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- TITLE -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Five in a Row"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#00FFFF"

        android:shadowColor="#00FFFF"
        android:shadowRadius="12"/>

    <!-- Center Container -->
    <LinearLayout
        android:layout_width="411dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="#22000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">


        <TextView
            android:id="@+id/tvMoves"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text="Moves: 0 "
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text=" Time: 00:00:00"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:text="Pause" />
    </LinearLayout>

    <!-- STATUS -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/glass_bg"
        android:padding="8dp"
        android:text="Player 1 turn"
        android:textAlignment="center"
        android:textColor="#FFFFFF" />


    <!-- theme ROW -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <!-- Theme-->
        <TextView
            android:text="Select Theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>
        <Spinner
            android:id="@+id/themeSpinner"
            android:layout_width="220dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <!-- mode ROW -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
    <!-- MODE -->
        <TextView
            android:text="Select Mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>
        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- DIFFICULTY ROW -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <!-- difficulty -->
        <TextView
            android:text="Select Difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>
        <Spinner
            android:id="@+id/difficultySpinner"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
<!--    &lt;!&ndash; START &ndash;&gt;-->
<!--    <Button-->
<!--        android:id="@+id/startBtn"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Start Game"-->
<!--        android:textColor="#00FFFF"-->
<!--        android:background="@drawable/neon_button"-->
<!--        android:layout_marginTop="8dp"/>-->

    <!-- BOARD -->
    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/glass_bg"
        android:padding="10dp"
        android:layout_marginTop="10dp">

        <com.example.fiveinarow.BoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </FrameLayout>

    <!-- BUTTON ROW -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/restartBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restart"
            android:textColor="#00FFFF"
            android:background="@drawable/neon_button"/>

        <Button
            android:id="@+id/undoBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Undo (5)"
            android:textColor="#00FFFF"
            android:background="@drawable/neon_button"
            android:layout_marginStart="10dp"/>

    </LinearLayout>

    <!-- BOTTOM EMPTY SPACE -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- FIREWORK -->
    <com.example.fiveinarow.FireworkView
        android:id="@+id/fireworkView"
        android:layout_width="0dp"
        android:layout_height="0dp"


        android:elevation="10dp"/>

</LinearLayout>


