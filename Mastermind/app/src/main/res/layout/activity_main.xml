<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="MASTERMIND"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerDifficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

<!--    <Switch-->
<!--        android:id="@+id/switchDuplicate"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Allow Duplicate Colors" />-->

<!--    switch duplicate colors-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/switchDuplicate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtDuplicateStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allowed"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtAttempts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Attempts: 12"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: 0"
        android:textSize="18sp" />

    <!-- status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <!-- secret Code Row -->
<!--    <LinearLayout-->
<!--        android:id="@+id/secretCodeRow"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:gravity="center"-->
<!--        android:orientation="horizontal" />-->
<!--    <HorizontalScrollView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content">-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/secretCodeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>

    </LinearLayout>

<!--    </HorizontalScrollView>-->

    <!-- Guess Row -->

    <LinearLayout
        android:id="@+id/guessRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:orientation="horizontal" />

    <!-- Feedback Pegs -->

    <!--    <GridLayout-->
    <!--        android:id="@+id/feedbackGrid"-->
    <!--        android:layout_width="80dp"-->
    <!--        android:layout_height="80dp"-->
    <!--        android:layout_gravity="center"-->
    <!--        android:layout_marginTop="15dp"-->
    <!--        android:columnCount="2"-->
    <!--        android:rowCount="2"/>-->
    <GridLayout
        android:id="@+id/feedbackGrid"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_gravity="center_horizontal"
        android:columnCount="6"
        android:rowCount="1" />

    <!-- Color Buttons -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/redBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#F44336"
                android:padding="0dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/blueBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#2196F3"
                android:padding="0dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/greenBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#4CAF50"
                android:padding="0dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/yellowBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#FFEB3B"
                android:padding="0dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/purpleBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#9C27B0"
                android:padding="0dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/orangeBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#FF9800"
                android:padding="0dp"
                android:text="6"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cyanBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#00BCD4"
                android:padding="0dp"
                android:text="7"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pinkBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#E91E63"
                android:padding="0dp"
                android:text="8"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/brownBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#795548"
                android:padding="0dp"
                android:text="9"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grayBtn"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:backgroundTint="#9E9E9E"
                android:padding="0dp"
                android:text="10"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

<!--        <com.google.android.material.button.MaterialButton-->
<!--            android:id="@+id/btnUndo"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_weight="1"-->
<!--            android:text="Undo" />-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRules"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rules"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CHECK" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Restart" />

    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
